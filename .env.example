# Supabase 연결 정보
# Supabase Dashboard → Project Settings → API 에서 복사
# 값을 채운 뒤 이 파일을 .env(또는 .env.local)로 복사하세요. (.env 는 git 에 커밋되지 않습니다)
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Analytics 4 (선택) — 측정 ID를 넣으면 프로덕션 빌드에서 활성화됩니다
VITE_GA4_ID=G-XXXXXXXXXX

# Vercel Deploy Hook (선택) — 관리자 페이지의 '사이트 반영' 버튼 활성화
# Vercel → Project Settings → Git → Deploy Hooks 에서 생성한 URL
VITE_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/yyy
